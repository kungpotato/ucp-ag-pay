# Read by backend/ (Go). Copy to .env at the repo root.
# OPENROUTER_API_KEY here is unused directly by the backend — the frontend
# reads its own copy from frontend/.env.local (see .env.local.example) —
# this key is kept here too only as the canonical source you copy from.

# Optional: enables LLM tool-calling via OpenRouter (Lesson 6). Without it,
# the /agent chat falls back to a deterministic rule-based parser
# automatically — no functionality is lost outside natural-language understanding.
OPENROUTER_API_KEY=

# Required from Lesson 3 onward: Stripe TEST MODE secret key (sk_test_...).
# Without it, POST /ucp/cart/:id/checkout returns a 502 with a clear
# "STRIPE_SECRET_KEY is not set" message instead of calling Stripe.
STRIPE_SECRET_KEY=

# Required from Lesson 5 onward: get this by running
#   stripe listen --forward-to localhost:8080/webhooks/stripe
# which prints a whsec_... value. Without it, /webhooks/stripe returns 400
# and orders stay stuck at pending_payment forever.
STRIPE_WEBHOOK_SECRET=
