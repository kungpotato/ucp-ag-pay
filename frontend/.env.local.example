# Where the Go backend (backend/) is listening. Not secret — it's read by
# both Server Components and the browser.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# Optional: enables LLM tool-calling via OpenRouter (Lesson 6). Without it,
# /agent falls back to a deterministic rule-based parser automatically.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash
